# HypCurl settings for every environment.
# Override per environment in <env>.env (env = HYPCURL_ENV, APP_ENV, or "dev") and secrets in local.env.
# Real environment variables override these files.

HYPCURL_LOG_LEVEL=INFO

# HTTP defaults (each API client / request can override these)
HYPCURL_TIMEOUT=30
HYPCURL_CONNECT_TIMEOUT=10
HYPCURL_RETRIES=0
HYPCURL_RETRY_DELAY_MS=500
# TLS: keep verification on in production. false = like `curl -k` (self-signed dev servers only).
HYPCURL_VERIFY_SSL=true
# Extra CA certificate (PEM) to trust, e.g. your company's internal CA. Relative to the project root.
HYPCURL_CA_BUNDLE=

# Redirects: follow 3xx Location headers (like curl -L), up to this many hops.
HYPCURL_FOLLOW_REDIRECTS=true
HYPCURL_MAX_REDIRECTS=10
HYPCURL_USER_AGENT=HypCurl/1.0
HYPCURL_DRY_RUN=false

# Extra headers sent with EVERY request to every API, separated by "|"
# e.g. HYPCURL_HEADERS=X-App: my-app | X-Env: dev
HYPCURL_HEADERS=

# Cookies: on = each API client keeps a cookie session (like a browser) for the whole script.
# HYPCURL_COOKIE_JAR = file to persist cookies between runs (relative to the project). Empty = memory only.
HYPCURL_COOKIES=true
HYPCURL_COOKIE_JAR=

# Proxy for all requests, e.g. http://127.0.0.1:8080, http://user:pass@host:3128, socks5h://127.0.0.1:1080
# Empty = curl's default (honours http_proxy/https_proxy env vars). "none" = never use a proxy.
HYPCURL_PROXY=
# Hosts that skip the proxy, e.g. localhost,127.0.0.1,.internal
HYPCURL_NO_PROXY=

# Your APIs' settings go here too, e.g.
# GITHUB_BASE_URL=https://api.github.com

<?php

declare(strict_types=1);

namespace {{namespace}};

use Hyphun\HypCurl\Api\ApiClient;
use Hyphun\HypCurl\Api\CrudResource;
use Hyphun\HypCurl\Core\Config;
use Hyphun\HypCurl\Http\Response;

/**
 * {{class}}: your API client, generated by `hypcurl make:api`.
 *
 * Use it anywhere (one shared instance):
 *   {{class}}::instance()->ping();
 *   {{class}}::instance()->items()->list(['page' => 1]);
 *
 * Or from the terminal:
 *   vendor/bin/hypcurl {{service}}                  # list methods
 *   vendor/bin/hypcurl {{service}} search php page=2
 *
 * It points at https://httpbin.org (which echoes requests back), so every example below
 * works straight away. Set {{prefix}}_BASE_URL and replace the example endpoints with your API's.
 */
final class {{class}} extends ApiClient
{
    // ------------------------------------------------------------------
    // 1. CONNECTION: base URL, auth, default headers, timeouts.
    //    Values come from config/hypcurl/*.env or environment variables.
    // ------------------------------------------------------------------
    protected function options(): array
    {
        $config = Config::instance();

        return [
            'baseUrl' => $config->get('{{prefix}}_BASE_URL', 'https://httpbin.org'),
            'headers' => array_filter([
                'Accept' => 'application/json',
                // Sent only when {{prefix}}_TOKEN is set. Use 'X-Api-Key' etc. if your API wants that instead.
                'Authorization' => ($token = $config->get('{{prefix}}_TOKEN')) ? "Bearer $token" : null,
            ]),
            'timeout' => $config->int('{{prefix}}_TIMEOUT', 30),
            'retries' => 2, // retry network errors, 429 and 5xx
            // 'proxy'     => $config->get('{{prefix}}_PROXY'),
            // 'cookieJar' => '.hypcurl/{{service}}-cookies.txt',   // keep login cookies between runs
        ];
    }

    /** Runs once after the client is created, e.g. to log in or set a header. */
    protected function boot(): void
    {
        // $this->withHeader('X-Tenant', Config::instance()->get('{{prefix}}_TENANT', 'default'));
    }

    // ------------------------------------------------------------------
    // 2. RESOURCES: standard REST collections get list/find/create/
    //    update/patch/delete with no code. Add one method per collection.
    // ------------------------------------------------------------------

    /** /items: list, find, create, update, patch, delete. */
    public function items(): CrudResource
    {
        return $this->resource(CrudResource::class, '/anything/items'); // e.g. '/items'
    }

    // ------------------------------------------------------------------
    // 3. YOUR ENDPOINTS: one method per call. Copy a pattern and edit it.
    // ------------------------------------------------------------------

    /** Health check: simple GET. */
    public function ping(): Response
    {
        return $this->get('/get')->send();
    }

    /** GET with query parameters: ?q=...&page=... */
    public function search(string $query, array $filters = []): Response
    {
        return $this->get('/anything/search')
            ->query(['q' => $query] + $filters)
            ->send();
    }

    /** POST a JSON body, with a per-request header. */
    public function createOrder(array $order): Response
    {
        return $this->post('/anything/orders')
            ->json($order)
            ->header('Idempotency-Key', bin2hex(random_bytes(8)))
            ->send();
    }

    /** Form login: the session cookie is reused automatically by every later call. */
    public function login(string $username, string $password): Response
    {
        return $this->post('/anything/login')
            ->form(['username' => $username, 'password' => $password])
            ->send();
    }

    /** Upload a file (multipart/form-data). */
    public function upload(string $file, string $note = ''): Response
    {
        return $this->post('/anything/upload')
            ->multipart(['note' => $note, 'file' => "@$file"])
            ->send();
    }

    /** Download to disk without loading it into memory. */
    public function download(string $saveTo): Response
    {
        return $this->get('/image/png')->header('Accept', 'image/png')->saveTo($saveTo)->send();
    }

    /** Return plain data instead of a Response: read fields with dot paths. */
    public function originIp(): ?string
    {
        return $this->get('/get')->send()->json('origin');
    }
}

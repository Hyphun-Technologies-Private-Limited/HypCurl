{
    "name": "hyphun/hypcurl",
    "description": "Organised, reusable cURL toolkit for PHP: singleton API clients, fluent requests, retries, cookies, proxies, custom headers and a CLI.",
    "type": "library",
    "license": "MIT",
    "keywords": ["curl", "http", "http-client", "api", "rest", "cli", "cookies", "proxy"],
    "authors": [
        {
            "name": "Raunak",
            "email": "raunak@hyphun.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "psr/log": "Pass any PSR-3 logger (e.g. Monolog) to HypCurl::boot(['logger' => ...])",
        "ext-fileinfo": "Detects MIME types for multipart file uploads"
    },
    "autoload": {
        "psr-4": {
            "Hyphun\\HypCurl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyphun\\HypCurl\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/hypcurl"],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
